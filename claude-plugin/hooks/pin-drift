#!/usr/bin/env bash
# Pin-drift hook.
#
# Compares the commit of the installed spoolway-companion with the `revision` the project's
# `.spoolway/plugin.lock` records (`$CLAUDE_PROJECT_DIR/.spoolway/plugin.lock`, written by
# `types.sh write`). Nothing is read from `.claude/settings.json`: the lock and the install records
# are the only sources. A project whose lock is absent or names another plugin has nothing to
# compare, and the hook stays silent. The install is the user's, one per machine, so the lock
# moves with `setup.sh bump` and the install with `claude plugin update ... --scope user`, and a
# restart follows either.
#
#   pin-drift session-start   warn the user, and tell the agent to keep out of the protected path
#   pin-drift pre-tool-use    deny Write/Edit under the protected path while drift persists
#
# The protected path is the project's PIN_DRIFT_PROTECTED: an environment variable of that
# name, else the `PIN_DRIFT_PROTECTED=<dir>` line of `.spoolway/companion.env` (read with grep,
# never sourced). Typically the directory a pinned plugin writes into, so nothing is written
# there by a copy older or newer than the pin. Without it the hook only warns.
#
# SPOOLWAY_COMPANION_WIKI_PIN_DRIFT_BLOCK=false (in the environment Claude Code starts in) turns the
# deny into a warning: writes under the protected path go through, and the user and the agent are
# told about the drift on each one. Any other value, or none, denies.
#
# Drift is recomputed on every call, so the gate lifts as soon as the install matches.
# The hook never blocks the session: every path exits 0.

set -u

mode="${1:-}"
input="$(cat 2>/dev/null || true)"

if ! command -v jq >/dev/null 2>&1; then
  if [ "$mode" = session-start ]; then
    printf '%s\n' '{"systemMessage":"spoolway-companion pin-drift: jq is not installed, so plugin pins cannot be checked."}'
  fi
  exit 0
fi

field() { jq -r "$1 // empty" <<<"$input" 2>/dev/null; }

project_dir="${CLAUDE_PROJECT_DIR:-$(field .cwd)}"
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
lock="$project_dir/.spoolway/plugin.lock"
installed_file="$config_dir/plugins/installed_plugins.json"

# protected_dir: PIN_DRIFT_PROTECTED from the environment, else from .spoolway/companion.env,
# without a leading ./ or a trailing slash. Empty when neither names one.
protected_dir() {
  local value="${PIN_DRIFT_PROTECTED:-}" env_file="$project_dir/.spoolway/companion.env"
  if [ -z "$value" ] && [ -f "$env_file" ]; then
    value="$(grep -E '^PIN_DRIFT_PROTECTED=' "$env_file" 2>/dev/null | tail -n 1 | cut -d= -f2-)"
  fi
  value="${value%"${value##*[![:space:]]}"}"
  value="${value#./}"
  printf '%s' "${value%/}"
}
protected="$(protected_dir)"

block=true
[ "${SPOOLWAY_COMPANION_WIKI_PIN_DRIFT_BLOCK:-}" = false ] && block=false
warn_note="SPOOLWAY_COMPANION_WIKI_PIN_DRIFT_BLOCK=false: writes under ${protected:-the protected path}/ are allowed despite the drift, so what is written now may follow a stale plugin."

PLUGIN=spoolway-companion
ID=spoolway-companion@spoolway-companion
MARKETPLACE=spoolway-companion

# The record that applies: the user-scope one (the install the catalogue model asks for), else
# this project's own record, else the most recently updated one.
PICK='def pick($dir):
  (map(select(.scope == "user")) | sort_by(.lastUpdated // "") | last)
  // (map(select(.projectPath == $dir)) | first)
  // (sort_by(.lastUpdated // "") | last);'

# locked_revision: the revision of the companion in the project's lock; nothing when the lock is
# absent or belongs to another plugin.
locked_revision() {
  [ -f "$lock" ] || return 0
  [ "$(sed -n 's/^plugin //p' "$lock" | head -n 1)" = "$PLUGIN" ] || return 0
  sed -n 's/^revision //p' "$lock" | head -n 1
}

plugin_list=""
plugin_list_state=""  # "", ok, failed
load_plugin_list() {
  [ -n "$plugin_list_state" ] && return
  plugin_list_state=failed
  command -v claude >/dev/null 2>&1 || return
  local runner=()
  command -v timeout >/dev/null 2>&1 && runner=(timeout 30)
  if plugin_list="$("${runner[@]}" claude plugin list --json 2>/dev/null)" \
    && jq -e 'type == "array"' <<<"$plugin_list" >/dev/null 2>&1; then
    plugin_list_state=ok
  fi
}

# Prints: status US installed US method-or-reason (US = \x1f: unlike a tab,
# read never collapses it, so an empty field survives)
#   status: match | drift | undecided
check_entry() {
  local sha="$1" installed_sha="" version

  if [ -f "$installed_file" ]; then
    installed_sha="$(jq -r --arg id "$ID" --arg dir "$project_dir" \
      "$PICK (.plugins[\$id] // []) | pick(\$dir) | .gitCommitSha // empty" \
      "$installed_file" 2>/dev/null)"
  fi
  if [ -n "$installed_sha" ]; then
    if [ "$installed_sha" = "$sha" ]; then
      printf 'match\x1f%s\x1fgitCommitSha\n' "$installed_sha"
    else
      printf 'drift\x1f%s\x1fgitCommitSha\n' "$installed_sha"
    fi
    return
  fi

  # Fallback: installed_plugins.json is absent or its record carries no gitCommitSha.
  load_plugin_list
  if [ "$plugin_list_state" != ok ]; then
    printf 'undecided\x1f\x1fno gitCommitSha in %s, and `claude plugin list --json` did not answer\n' "$installed_file"
    return
  fi
  version="$(jq -r --arg id "$ID" --arg dir "$project_dir" \
    "$PICK map(select(.id == \$id)) | pick(\$dir) | .version // empty" <<<"$plugin_list")"
  if [[ "$version" =~ ^([0-9a-f]{12})(-|$) ]]; then
    # A plugin without a version is cached under its commit: <sha12>[-<suffix>].
    if [ "${BASH_REMATCH[1]}" = "${sha:0:12}" ]; then
      printf 'match\x1f%s\x1fversion\n' "$version"
    else
      printf 'drift\x1f%s\x1fversion\n' "$version"
    fi
  else
    printf 'undecided\x1f%s\x1fno gitCommitSha, and version "%s" is no commit\n' "$version" "$version"
  fi
}

# Fills: drift_lines, commands, undecided_lines.
evaluate() {
  drift_lines="" commands="" undecided_lines=""
  local sha status installed how
  sha="$(locked_revision)"
  [ -n "$sha" ] || return 0
  IFS=$'\x1f' read -r status installed how < <(check_entry "$sha")
  case "$status" in
    drift)
      drift_lines+="- ${ID}: installed ${installed:0:12} (by ${how}), .spoolway/plugin.lock holds ${sha:0:12}."$'\n'
      commands+="claude plugin marketplace update ${MARKETPLACE}"$'\n'"claude plugin update ${ID} --scope user"$'\n'"(or, when the install is the newer one: /${PLUGIN}:setup bump, to retake the types at the installed revision)"$'\n' ;;
    undecided)
      undecided_lines+="- ${ID}: cannot decide whether the install matches ${sha:0:12}: ${how}."$'\n' ;;
  esac
}

session_start() {
  evaluate
  [ -z "$drift_lines$undecided_lines" ] && return

  local message="spoolway-companion pin-drift" context=""
  if [ -n "$drift_lines" ]; then
    message+=$'\nThe installed plugin does not match the revision in .spoolway/plugin.lock:\n'"$drift_lines"
    message+=$'Run, then restart Claude Code:\n'"$commands"
    context="Plugin pin drift: the installed plugin does not match the revision in .spoolway/plugin.lock."$'\n'"$drift_lines"
    if [ -n "$protected" ] && [ "$block" = true ]; then
      context+="Do not write into $protected/ until it matches. Write and Edit under $protected/ are denied; do not use Bash or any other tool to write there either. "
    elif [ -n "$protected" ]; then
      message+=$'\n'"$warn_note"
      context+="$warn_note Mention the drift to the user before writing there. "
    fi
    context+="Ask the user to run the following, then restart Claude Code:"$'\n'"$commands"
  fi
  [ -n "$undecided_lines" ] && message+=$'\n'"$undecided_lines"

  jq -n --arg message "${message%$'\n'}" --arg context "${context%$'\n'}" '
    {systemMessage: $message}
    + (if $context == "" then {} else
        {hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $context}}
      end)'
}

pre_tool_use() {
  local path cwd
  [ -n "$protected" ] || return
  path="$(field .tool_input.file_path)"
  [ -n "$path" ] || return
  cwd="$(field .cwd)"
  case "$path" in /*) ;; *) path="${cwd:-$project_dir}/$path" ;; esac
  case "$path/" in */"$protected"/*) ;; *) return ;; esac

  evaluate
  [ -n "$drift_lines" ] || return

  if [ "$block" = false ]; then
    jq -n --arg warning "spoolway-companion pin-drift: $warn_note"$'\n'"${drift_lines}Run, then restart Claude Code:"$'\n'"${commands%$'\n'}" '
      {systemMessage: $warning,
       hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $warning}}'
    return
  fi

  jq -n --arg reason "Writes under $protected/ are blocked until the installed plugin matches .spoolway/plugin.lock."$'\n'"${drift_lines}Ask the user to run, then restart Claude Code:"$'\n'"${commands%$'\n'}" '
    {hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
}

case "$mode" in
  session-start) session_start ;;
  pre-tool-use) pre_tool_use ;;
esac
exit 0
